#. Plugin Name of the plugin
#: offair.php
msgid "Offair - Branded Error Pages"
msgstr "Offair - Pages d’erreur à vos couleurs"

#. Plugin URI of the plugin
#: offair.php
msgid "https://github.com/nolidev-fr/offair"
msgstr "https://github.com/nolidev-fr/offair"

#. Description of the plugin
#: offair.php
msgid "Branded pages for the screens WordPress shows by itself when it breaks: database connection errors, fatal PHP errors and the update notice. Works even when WordPress cannot load."
msgstr "Des pages aux couleurs de votre site pour les écrans que WordPress affiche de lui-même quand il tombe en panne : erreur de connexion à la base de données, erreur PHP fatale et avis de mise à jour. Fonctionne même quand WordPress ne peut pas démarrer."

#. Author of the plugin
#: offair.php
msgid "Nolidev"
msgstr "Nolidev"

#. Author URI of the plugin
#: offair.php
msgid "https://nolidev.fr"
msgstr "https://nolidev.fr"

