msgstr "Le mode de récupération est actif : l’extension à l’origine de cette erreur a été mise en pause. Consultez les écrans Extensions et Thèmes pour en savoir plus."

#: includes/class-settings.php:88
msgid "Database error"
msgstr "Erreur de base de données"

#: includes/class-settings.php:89
msgid "Maintenance"
msgstr "Maintenance"

#: includes/class-settings.php:90
msgid "PHP error"
msgstr "Erreur PHP"

#: includes/class-settings.php:105
msgid "Try again"
msgstr "Réessayer"

#: includes/class-settings.php:119
msgid "We'll be right back"
msgstr "Nous revenons tout de suite"

#: includes/class-settings.php:120
msgid "Our site is taking a short break because of a technical problem. It usually comes back within a few minutes.\n\nThis page refreshes on its own. Thank you for your patience."
msgstr "Notre site fait une courte pause à cause d’un problème technique. Il revient en général au bout de quelques minutes.\n\nCette page se rafraîchit toute seule. Merci de votre patience."

#: includes/class-settings.php:129
msgid "Back in a minute"
msgstr "De retour dans une minute"

#: includes/class-settings.php:130
msgid "We are installing an update. The site will be back in a moment.\n\nThis page refreshes on its own. Thank you for your patience."
msgstr "Nous installons une mise à jour. Le site revient dans un instant.\n\nCette page se rafraîchit toute seule. Merci de votre patience."

#: includes/class-settings.php:139
msgid "Something went wrong"
msgstr "Un problème est survenu"

#: includes/class-settings.php:140
msgid "A technical error prevents us from displaying this page right now. Please try again in a few minutes.\n\nThank you for your patience."
msgstr "Une erreur technique nous empêche d’afficher cette page pour le moment. Réessayez dans quelques minutes.\n\nMerci de votre patience."

#: includes/class-site-health.php:43
msgid "Be Right Back pages"
msgstr "Pages Be Right Back"

#. translators: 1: page name, 2: file name.
#: includes/class-site-health.php:67
#, php-format
