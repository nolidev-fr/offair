msgstr "Page"

#: includes/class-admin-page.php:378
msgid "File"
msgstr "Fichier"

#: includes/class-admin-page.php:379
msgid "State"
msgstr "État"

#. translators: 1: plugin version, 2: generation date.
#: includes/class-admin-page.php:394
#, php-format
msgid "Written by Be Right Back %1$s on %2$s"
msgstr "Écrit par Be Right Back %1$s le %2$s"

#: includes/class-admin-page.php:396
msgid "Written by another plugin or a person. It is never overwritten without your say."
msgstr "Écrit par une autre extension ou une personne. Il n’est jamais écrasé sans votre accord."

#: includes/class-admin-page.php:401
msgid "Blocked by the PHP configuration"
msgstr "Bloquée par la configuration PHP"

