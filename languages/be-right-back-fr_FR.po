msgid "https://github.com/nolidev-fr/be-right-back"
msgstr "https://github.com/nolidev-fr/be-right-back"

#. Description of the plugin
#: be-right-back.php
msgid "Friendly branded pages when your site is down: database errors, fatal errors and maintenance mode. Works even when WordPress cannot load."
msgstr "Des pages d’indisponibilité soignées, aux couleurs de votre site : erreur de base de données, erreur fatale et mode maintenance. Fonctionne même quand WordPress ne peut pas démarrer."

#. Author of the plugin
#: be-right-back.php
msgid "Nolidev"
msgstr "Nolidev"

#. Author URI of the plugin
#: be-right-back.php
msgid "https://nolidev.fr"
msgstr "https://nolidev.fr"

#: includes/class-admin-page.php:143
msgid "Choose a logo"
msgstr "Choisir un logo"

#: includes/class-admin-page.php:144
msgid "Use this logo"
msgstr "Utiliser ce logo"

#: includes/class-admin-page.php:156
msgid "Settings"
msgstr "Réglages"

#: includes/class-admin-page.php:175
msgid "Settings saved and pages regenerated."
msgstr "Réglages enregistrés et pages regénérées."

#: includes/class-admin-page.php:188
msgid "Pages regenerated."
msgstr "Pages regénérées."

#: includes/class-admin-page.php:200
msgid "Pages removed from wp-content. They will be written again the next time you save or regenerate."
msgstr "Pages supprimées de wp-content. Elles seront réécrites au prochain enregistrement ou à la prochaine regénération."

#: includes/class-admin-page.php:224
msgid "The preview could not be written to a temporary file."
msgstr "La prévisualisation n’a pas pu être écrite dans un fichier temporaire."

#: includes/class-admin-page.php:233
msgid "Sample error shown by the preview. Real errors appear here only when WP_DEBUG_DISPLAY is enabled."
msgstr "Erreur d’exemple affichée par la prévisualisation. Les vraies erreurs n’apparaissent ici que si WP_DEBUG_DISPLAY est activé."

#: includes/class-admin-page.php:288
msgid "Branded pages shown to visitors when the database is unreachable, when WordPress updates itself and when a fatal PHP error occurs. The pages are written to wp-content so they work even when WordPress cannot load."
msgstr "Pages aux couleurs du site affichées aux visiteurs quand la base de données est injoignable, pendant les mises à jour de WordPress et lors d’une erreur PHP fatale. Les pages sont écrites dans wp-content, elles fonctionnent donc même quand WordPress ne peut pas démarrer."

#: includes/class-admin-page.php:291
msgid "On a network the three pages are shared by every site. These settings apply to the whole network."
msgstr "Sur un réseau, les trois pages sont communes à tous les sites. Ces réglages s’appliquent à l’ensemble du réseau."

#: includes/class-admin-page.php:298
msgid "General"
msgstr "Général"

#: includes/class-admin-page.php:302
msgid "Advanced"
msgstr "Avancé"

#: includes/class-admin-page.php:321
msgid "Save and regenerate pages"
msgstr "Enregistrer et regénérer les pages"

#: includes/class-admin-page.php:367
#: includes/class-admin-page.php:530
msgid "Page"
msgstr "Page"

#: includes/class-admin-page.php:368
msgid "File"
msgstr "Fichier"

#: includes/class-admin-page.php:369
msgid "State"
msgstr "État"

#: includes/class-admin-page.php:370
msgid "Written by"
msgstr "Écrit par"

