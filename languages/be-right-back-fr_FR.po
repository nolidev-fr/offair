msgstr "La page %1$s est activée mais wp-content/%2$s est absent."

#. translators: 1: page name, 2: file name.
#: includes/class-site-health.php:71
#, php-format
msgid "wp-content/%2$s does not match the current settings of the %1$s page."
msgstr "wp-content/%2$s ne correspond pas aux réglages actuels de la page %1$s."

#. translators: %s: file name.
#: includes/class-site-health.php:75
#, php-format
msgid "wp-content/%s was not written by Be Right Back. The plugin leaves it untouched, so this page is not branded."
msgstr "wp-content/%s n’a pas été écrit par Be Right Back. L’extension n’y touche pas, cette page n’est donc pas aux couleurs du site."

#: includes/class-site-health.php:82
msgid "The PHP error page cannot be shown with the current PHP configuration."
msgstr "La page d’erreur PHP ne peut pas s’afficher avec la configuration PHP actuelle."

#: includes/class-site-health.php:86
msgid "wp-content is not writable, so the pages cannot be written automatically. Download them from the settings page and upload them yourself."
msgstr "wp-content n’est pas inscriptible, les pages ne peuvent donc pas être écrites automatiquement. Téléchargez-les depuis la page de réglages et déposez-les vous-même."

#: includes/class-site-health.php:94
msgid "Your downtime pages are in place"
msgstr "Vos pages d’indisponibilité sont en place"

#: includes/class-site-health.php:100
msgid "Visitors see a branded page when the database is unreachable, during updates and on fatal errors."
msgstr "Les visiteurs voient une page aux couleurs du site quand la base de données est injoignable, pendant les mises à jour et lors des erreurs fatales."

#: includes/class-site-health.php:101
msgid "Open the Be Right Back settings"
msgstr "Ouvrir les réglages de Be Right Back"

#: includes/class-site-health.php:106
msgid "Some downtime pages need attention"
msgstr "Certaines pages d’indisponibilité demandent votre attention"

#. translators: 1: local time of the incident (computed when the page is served), 2: timezone name, 3: sentence describing the incident.
#: templates/partials/content.php:43
#, php-format
msgid "Incident recorded at %1$s (%2$s). %3$s"
msgstr "Incident constaté à %1$s (%2$s). %3$s"
