#. translators: 1: page name, 2: file name.
#: includes/class-site-health.php:67
#, php-format
msgid "The %1$s page is enabled but wp-content/%2$s is missing."
msgstr "A página %1$s está ativada, mas wp-content/%2$s está ausente."

#. translators: 1: page name, 2: file name.
#: includes/class-site-health.php:71
#, php-format
msgid "wp-content/%2$s does not match the current settings of the %1$s page."
msgstr "wp-content/%2$s não corresponde às configurações atuais da página %1$s."

#. translators: %s: file name.
#: includes/class-site-health.php:75
#, php-format
msgid "wp-content/%s was not added by Offair. The plugin leaves it untouched, so this page is not branded."
msgstr "wp-content/%s não foi adicionado pelo Offair. O plugin não o altera, então esta página não está com as cores do site."

#: includes/class-site-health.php:82
msgid "The PHP error page cannot be shown with the current PHP configuration."
msgstr "A página de erro de PHP não pode ser exibida com a configuração atual do PHP."

#: includes/class-site-health.php:86
msgid "The uploads folder uses a custom path stored in the database, so the pages cannot read their content and show a neutral English page instead."
msgstr "A pasta uploads usa um caminho personalizado salvo no banco de dados, então as páginas não conseguem ler o seu conteúdo e exibem uma página neutra em inglês no lugar."

#: includes/class-site-health.php:90
msgid "wp-content is not writable, so the pages cannot be written automatically. Download them from the settings page and upload them yourself."
msgstr "wp-content não tem permissão de escrita, então as páginas não podem ser escritas automaticamente. Baixe-as pela página de configurações e envie-as você mesmo."

#: includes/class-site-health.php:98
msgid "Your downtime pages are in place"
msgstr "As suas páginas de indisponibilidade estão no lugar"

#: includes/class-site-health.php:104
msgid "Visitors see a branded page when the database is unreachable, during updates and on fatal errors."
msgstr "Os visitantes veem uma página com as cores do site quando o banco de dados está inacessível, durante as atualizações e em erros fatais."

#: includes/class-site-health.php:105
msgid "Open the Offair settings"
msgstr "Abrir as configurações do Offair"

#: includes/class-site-health.php:110
msgid "Some downtime pages need attention"
msgstr "Algumas páginas de indisponibilidade precisam de atenção"

#: includes/class-admin-page.php:952
msgid "For a PHP error, the error itself is kept too: its message, file and line, which usually name the plugin or theme in cause. Paths start from the WordPress folder."
msgstr "Em um erro de PHP, o próprio erro também é guardado: a mensagem, o arquivo e a linha, que geralmente apontam o plugin ou o tema responsável. Os caminhos partem da pasta do WordPress."

