#. Plugin Name of the plugin
#: offair.php
msgid "Offair - Branded Error Pages"
msgstr "Offair - Strony błędów w barwach Twojej witryny"

#. Plugin URI of the plugin
#: offair.php
msgid "https://github.com/nolidev-fr/offair"
msgstr "https://github.com/nolidev-fr/offair"

#. Description of the plugin
#: offair.php
msgid "Branded pages for the screens WordPress shows by itself when it breaks: database connection errors, fatal PHP errors and the update notice. Works even when WordPress cannot load."
msgstr "Strony w barwach Twojej witryny dla ekranów, które WordPress wyświetla sam, gdy coś się psuje: błędy połączenia z bazą danych, krytyczne błędy PHP i komunikat podczas aktualizacji. Działa nawet wtedy, gdy WordPress nie może się uruchomić."

#. Author of the plugin
#: offair.php
msgid "Nolidev"
msgstr "Nolidev"

#. Author URI of the plugin
#: offair.php
msgid "https://nolidev.fr"
msgstr "https://nolidev.fr"

#: includes/class-admin-page.php:146
#: includes/class-admin-page.php:147
#: includes/class-admin-page.php:417
#: includes/class-site-health.php:43
#: includes/class-site-health.php:101
msgid "Offair"
msgstr "Offair"

#: includes/class-admin-page.php:172
msgid "Choose a logo"
msgstr "Wybierz logo"

#: includes/class-admin-page.php:173
msgid "Use this logo"
msgstr "Użyj tego logo"

#: includes/class-admin-page.php:185
msgid "Settings"
msgstr "Ustawienia"

#: includes/class-admin-page.php:205
msgid "Settings saved and pages regenerated."
msgstr "Ustawienia zapisane, a strony wygenerowane ponownie."

#: includes/class-admin-page.php:218
msgid "Pages regenerated."
msgstr "Strony wygenerowane ponownie."

#: includes/class-admin-page.php:230
msgid "Pages removed from wp-content. They will be written again the next time you save or regenerate."
msgstr "Strony usunięte z wp-content. Zostaną zapisane ponownie przy następnym zapisie ustawień lub ponownym generowaniu."

#: includes/class-admin-page.php:246
msgid "Sample error shown by the preview. Real errors appear here only when WP_DEBUG and WP_DEBUG_DISPLAY are enabled."
msgstr "Przykładowy błąd pokazany w podglądzie. Prawdziwe błędy pojawiają się tu tylko wtedy, gdy WP_DEBUG i WP_DEBUG_DISPLAY są włączone."

#: includes/class-admin-page.php:312
msgid "Settings saved. No test was sent: enter a valid email address first."
msgstr "Ustawienia zapisane. Nie wysłano testu: najpierw wpisz prawidłowy adres e-mail."

#. translators: %s: email address.
#: includes/class-admin-page.php:315
#, php-format
msgid "Settings saved. A test alert was handed to the server for %s. Check the inbox and the spam folder: if it never arrives, this host does not deliver the emails PHP sends by itself."
msgstr "Ustawienia zapisane. Testowe powiadomienie dla %s zostało przekazane serwerowi. Sprawdź skrzynkę odbiorczą i folder spamu: jeśli nigdy nie dotrze, ten hosting nie dostarcza wiadomości wysyłanych bezpośrednio przez PHP."

#: includes/class-admin-page.php:317
msgid "Settings saved."
msgstr "Ustawienia zapisane."

#: includes/class-admin-page.php:318
msgid "The server refused to send the test: the mail function of PHP does not work on this host, so no alert can be sent during an outage. The report sent once the site is back goes through WordPress and is not affected."
msgstr "Serwer odmówił wysłania testu: funkcja mail w PHP nie działa na tym hostingu, więc podczas awarii nie da się wysłać żadnego powiadomienia. Podsumowanie wysyłane po powrocie witryny przechodzi przez WordPressa i nie jest tym objęte."

#: includes/class-admin-page.php:323
msgid "The email alert itself is off, so nothing will be sent during an outage. Tick Email alert and save to turn it on."
msgstr "Samo powiadomienie e-mail jest wyłączone, więc podczas awarii nic nie zostanie wysłane. Zaznacz Powiadomienie e-mail i zapisz, aby je włączyć."

#: includes/class-admin-page.php:338
msgid "History cleared."
msgstr "Historia wyczyszczona."

#. translators: 1: date and time the outage started, 2: duration, for example "about 15 mins".
#: includes/class-admin-page.php:384
#, php-format
msgid "Offair: the database of this site could not be reached on %1$s (%2$s). Visitors saw the database error page."
msgstr "Offair: baza danych tej witryny była nieosiągalna %1$s (%2$s). Odwiedzający widzieli stronę błędu bazy danych."

#: includes/class-admin-page.php:391
msgid "See the history"
msgstr "Zobacz historię"

#: includes/class-admin-page.php:393
msgid "Dismiss"
msgstr "Ukryj"

#: includes/class-admin-page.php:418
msgid "Branded pages shown to visitors when the database is unreachable, when WordPress updates itself and when a fatal PHP error occurs. WordPress loads them from wp-content before any plugin, so they work even when WordPress cannot load."
msgstr "Strony w barwach Twojej witryny pokazywane odwiedzającym, gdy baza danych jest nieosiągalna, gdy WordPress się aktualizuje i gdy wystąpi krytyczny błąd PHP. WordPress wczytuje je z wp-content przed jakąkolwiek wtyczką, więc działają nawet wtedy, gdy WordPress nie może się uruchomić."

#: includes/class-admin-page.php:421
msgid "On a network the three pages are shared by every site. These settings apply to the whole network."
msgstr "W sieci wszystkie witryny korzystają z tych samych trzech stron. Te ustawienia dotyczą całej sieci."

#: includes/class-admin-page.php:428
msgid "General"
msgstr "Ogólne"

#: includes/class-admin-page.php:432
msgid "History"
msgstr "Historia"

#: includes/class-admin-page.php:433
msgid "Advanced"
msgstr "Zaawansowane"

#: includes/class-admin-page.php:458
msgid "Save and regenerate pages"
msgstr "Zapisz i wygeneruj strony ponownie"

#: includes/class-admin-page.php:509
#: includes/class-admin-page.php:777
#: includes/class-admin-page.php:973
msgid "Page"
msgstr "Strona"

#: includes/class-admin-page.php:510
msgid "File"
msgstr "Plik"

#: includes/class-admin-page.php:511
msgid "State"
msgstr "Stan"

#: includes/class-admin-page.php:525
msgid "Added by another plugin or a person. It is never replaced without your say."
msgstr "Dodany przez inną wtyczkę lub przez kogoś. Nigdy nie jest zastępowany bez Twojej zgody."

#: includes/class-admin-page.php:530
msgid "Blocked by the PHP configuration"
msgstr "Zablokowana przez konfigurację PHP"

#: includes/class-admin-page.php:534
msgid "Preview"
msgstr "Podgląd"

#: includes/class-admin-page.php:535
msgid "Download"
msgstr "Pobierz"

#: includes/class-admin-page.php:542
msgid "The PHP error page cannot be shown with the current PHP configuration. Open the PHP error tab for the explanation and the fix."
msgstr "Strony błędu PHP nie można wyświetlić przy obecnej konfiguracji PHP. Otwórz kartę Błąd PHP, aby poznać wyjaśnienie i rozwiązanie."

#. translators: 1: number of sites with their page written, 2: number of sites of the network besides the main site.
#: includes/class-admin-page.php:550
#, php-format
msgid "Each site of the network has its own page: %1$d of %2$d site written."
msgid_plural "Each site of the network has its own page: %1$d of %2$d sites written."
msgstr[0] "Każda witryna w sieci ma własną stronę: zapisano %1$d z %2$d witryny."
msgstr[1] "Każda witryna w sieci ma własną stronę: zapisano %1$d z %2$d witryn."
msgstr[2] "Każda witryna w sieci ma własną stronę: zapisano %1$d z %2$d witryn."

#: includes/class-admin-page.php:557
msgid "Some sites of the network do not have their page yet. A large network is written in the background, batch after batch. Regenerate from the Advanced tab to write them now."
msgstr "Niektóre witryny w sieci nie mają jeszcze swojej strony. Duża sieć jest zapisywana w tle, partia po partii. Wygeneruj strony ponownie na karcie Zaawansowane, aby zapisać je od razu."

#: includes/class-admin-page.php:561
msgid "The uploads folder of this site uses a custom path stored in the database. The pages cannot read their content from there and show a neutral English page instead."
msgstr "Folder uploads tej witryny używa niestandardowej ścieżki zapisanej w bazie danych. Strony nie mogą stamtąd odczytać swojej treści i zamiast tego wyświetlają neutralną stronę w języku angielskim."

#: includes/class-admin-page.php:564
msgid "The uploads folder is not writable, so the content of the pages cannot be saved."
msgstr "Folder uploads nie jest zapisywalny, więc nie można zapisać treści stron."

#: includes/class-admin-page.php:567
msgid "The drop-ins are in wp-content and the content of the pages is updated whenever you save."
msgstr "Drop-iny są w wp-content, a treść stron jest aktualizowana przy każdym zapisie."

#: includes/class-admin-page.php:569
msgid "wp-content is not writable, so the drop-ins cannot be added automatically. Download them from the table above and upload them to wp-content with FTP or SFTP. This is needed only once: your later changes are saved in the uploads folder."
msgstr "Katalog wp-content nie jest zapisywalny, więc nie można automatycznie dodać drop-inów. Pobierz je z tabeli powyżej i wyślij do wp-content przez FTP lub SFTP. Wystarczy zrobić to raz: późniejsze zmiany są zapisywane w folderze uploads."

#: includes/class-admin-page.php:584
msgid "Each site of the network shows its own page: its title, its logo or site icon, its language and its timezone. The design, the colors and the texts set here are shared by every site."
msgstr "Każda witryna w sieci wyświetla własną stronę: swój tytuł, swoje logo lub ikonę witryny, swój język i swoją strefę czasową. Wygląd, kolory i teksty ustawione tutaj są wspólne dla wszystkich witryn."

#: includes/class-admin-page.php:589
msgid "Logo"
msgstr "Logo"

#: includes/class-admin-page.php:593
msgid "Embedded in the pages at 300 pixels wide at most, so it shows even when the media library is unreachable. PNG, JPG, SVG and WebP. A site of the network with a logo or site icon of its own shows it instead."
msgstr "Osadzone w stronach w szerokości do 300 pikseli, aby było widoczne nawet wtedy, gdy biblioteka mediów jest nieosiągalna. PNG, JPG, SVG i WebP. Witryna w sieci z własnym logo lub ikoną witryny wyświetla je zamiast tego."

#: includes/class-admin-page.php:594
msgid "Embedded in the pages at 300 pixels wide at most, so it shows even when the media library is unreachable. PNG, JPG, SVG and WebP."
msgstr "Osadzone w stronach w szerokości do 300 pikseli, aby było widoczne nawet wtedy, gdy biblioteka mediów jest nieosiągalna. PNG, JPG, SVG i WebP."

#: includes/class-admin-page.php:597
msgid "Logo on dark backgrounds"
msgstr "Logo na ciemne tło"

#: includes/class-admin-page.php:600
msgid "Optional, usually a white version of the logo. It replaces the logo in dark mode and on a dark colored panel. Leave empty to keep the logo as it is everywhere."
msgstr "Opcjonalne, zwykle biała wersja logo. Zastępuje logo w trybie ciemnym i na ciemnym kolorowym panelu. Pozostaw puste, aby wszędzie używać logo bez zmian."

#: includes/class-admin-page.php:603
msgid "Displayed name"
msgstr "Wyświetlana nazwa"

#: includes/class-admin-page.php:609
msgid "Shown above the title on the main site. Leave empty to use its title. The other sites of the network show their own title."
msgstr "Wyświetlana nad tytułem w witrynie głównej. Pozostaw puste, aby użyć jej tytułu. Pozostałe witryny w sieci wyświetlają własny tytuł."

#: includes/class-admin-page.php:610
msgid "Shown above the title. Leave empty to use the site title."
msgstr "Wyświetlana nad tytułem. Pozostaw puste, aby użyć tytułu witryny."

#: includes/class-admin-page.php:614
msgid "Name display"
msgstr "Wyświetlanie nazwy"

#: includes/class-admin-page.php:617
msgid "Show the name above the title. Uncheck it when the logo already contains the name."
msgstr "Wyświetl nazwę nad tytułem. Odznacz, jeśli logo zawiera już nazwę."

#: includes/class-admin-page.php:620
msgid "Layout"
msgstr "Układ"

#: includes/class-admin-page.php:624
msgid "Card: the message in a card centered on the background"
msgstr "Karta: komunikat na karcie wyśrodkowanej na tle"

#: includes/class-admin-page.php:625
msgid "Minimal: the message right on the background, without a card"
msgstr "Minimalistyczny: komunikat bezpośrednio na tle, bez karty"

#: includes/class-admin-page.php:626
msgid "Two columns: a panel in the primary color with the logo, the message beside it"
msgstr "Dwie kolumny: panel w kolorze głównym z logo, komunikat obok"

#: includes/class-admin-page.php:627
msgid "Banner: a band in the primary color with the logo, the message below"
msgstr "Pasek: pas w kolorze głównym z logo, komunikat poniżej"

#: includes/class-admin-page.php:631
msgid "Appearance"
msgstr "Wygląd"

#: includes/class-admin-page.php:635
msgid "Automatic: light or dark, as set on the device of the visitor"
msgstr "Automatyczny: jasny lub ciemny, zgodnie z ustawieniem urządzenia odwiedzającego"

#: includes/class-admin-page.php:636
msgid "Always light"
msgstr "Zawsze jasny"

#: includes/class-admin-page.php:637
msgid "Always dark"
msgstr "Zawsze ciemny"

#: includes/class-admin-page.php:639
msgid "In dark mode the background and the card turn dark, and the primary color is lightened where it colors text, so that it stays readable."
msgstr "W trybie ciemnym tło i karta stają się ciemne, a kolor główny jest rozjaśniany tam, gdzie barwi tekst, aby pozostał czytelny."

#: includes/class-admin-page.php:642
msgid "Primary color"
msgstr "Kolor główny"

#: includes/class-admin-page.php:647
msgid "Used for the name, the ornament and the button."
msgstr "Używany dla nazwy, ozdobnika i przycisku."

#: includes/class-admin-page.php:651
msgid "Button text color"
msgstr "Kolor tekstu przycisku"

#: includes/class-admin-page.php:656
msgid "Leave empty for an automatic choice: white text, on a slightly darkened button when a mid-tone color needs it, or dark text on a light color."
msgstr "Pozostaw puste, aby wybór był automatyczny: biały tekst, na lekko przyciemnionym przycisku, gdy wymaga tego kolor o średnim tonie, albo ciemny tekst na jasnym kolorze."

#: includes/class-admin-page.php:660
msgid "Background color"
msgstr "Kolor tła"

#: includes/class-admin-page.php:666
msgid "Heading font"
msgstr "Krój pisma nagłówków"

#: includes/class-admin-page.php:670
msgid "Serif (Georgia, Palatino)"
msgstr "Szeryfowy (Georgia, Palatino)"

#: includes/class-admin-page.php:671
msgid "Sans-serif (system font)"
msgstr "Bezszeryfowy (czcionka systemowa)"

#: includes/class-admin-page.php:673
msgid "System fonts only: nothing is loaded from the network."
msgstr "Tylko czcionki systemowe: nic nie jest pobierane z sieci."

#: includes/class-admin-page.php:676
msgid "Ornament"
msgstr "Ozdobnik"

#: includes/class-admin-page.php:680
msgid "Wave"
msgstr "Fala"

#: includes/class-admin-page.php:681
msgid "Line"
msgstr "Linia"

#: includes/class-admin-page.php:682
msgid "None"
msgstr "Brak"

#: includes/class-admin-page.php:686
msgid "Contact line"
msgstr "Wiersz kontaktowy"

#: includes/class-admin-page.php:690
msgid "Need help? Write to hello@example.com"
msgstr "Potrzebujesz pomocy? Napisz na kontakt@example.com"

#: includes/class-admin-page.php:691
msgid "Plain text shown under the button. Email addresses and web addresses become links."
msgstr "Zwykły tekst wyświetlany pod przyciskiem. Adresy e-mail i adresy stron stają się odnośnikami."

#: includes/class-admin-page.php:718
msgid "Choose from the media library"
msgstr "Wybierz z biblioteki mediów"

#: includes/class-admin-page.php:719
#: includes/class-admin-page.php:1039
msgid "Remove"
msgstr "Usuń"

#. translators: %s: file size, for example 150 KB.
#: includes/class-admin-page.php:727
#, php-format
msgid "This logo cannot be embedded, so the pages are shown without it. An SVG has to weigh less than %s, unless all it contains is one image. Try a PNG or JPG version of the logo."
msgstr "Tego logo nie można osadzić, więc strony są wyświetlane bez niego. Plik SVG musi ważyć mniej niż %s, chyba że zawiera tylko jeden obraz. Spróbuj wersji logo w formacie PNG lub JPG."

#: includes/class-admin-page.php:747
msgid "Shown when WordPress cannot connect to the database. Answers with HTTP 503 so search engines treat the outage as temporary."
msgstr "Wyświetlana, gdy WordPress nie może połączyć się z bazą danych. Odpowiada kodem HTTP 503, aby wyszukiwarki traktowały awarię jako tymczasową."

#: includes/class-admin-page.php:748
msgid "Shown while WordPress updates itself, a theme or a plugin. Answers with HTTP 503."
msgstr "Wyświetlana, gdy WordPress aktualizuje siebie, motyw lub wtyczkę. Odpowiada kodem HTTP 503."

#: includes/class-admin-page.php:749
msgid "Shown when a fatal PHP error stops the page. Technical details are added only when WP_DEBUG and WP_DEBUG_DISPLAY are enabled."
msgstr "Wyświetlana, gdy krytyczny błąd PHP przerywa stronę. Szczegóły techniczne są dodawane tylko wtedy, gdy WP_DEBUG i WP_DEBUG_DISPLAY są włączone."

#: includes/class-admin-page.php:754
msgid "Leave empty to use the default text in the language of the site."
msgstr "Pozostaw puste, aby użyć domyślnego tekstu w języku witryny."

#. translators: %s: path of the template file.
#: includes/class-admin-page.php:767
#, php-format
msgid "The active theme replaces this page with its template %s. The settings below are passed to it, and the template decides what to show."
msgstr "Aktywny motyw zastępuje tę stronę swoim szablonem %s. Poniższe ustawienia są mu przekazywane, a to szablon decyduje, co wyświetlić."

#. translators: %s: file name.
#: includes/class-admin-page.php:781
#, php-format
msgid "Write wp-content/%s"
msgstr "Zapisz wp-content/%s"

#: includes/class-admin-page.php:784
msgid "Title"
msgstr "Tytuł"

#: includes/class-admin-page.php:793
msgid "Message"
msgstr "Komunikat"

#: includes/class-admin-page.php:796
msgid "Plain text. Leave a blank line between paragraphs."
msgstr "Zwykły tekst. Zostaw pusty wiersz między akapitami."

#: includes/class-admin-page.php:800
msgid "Retry button"
msgstr "Przycisk Spróbuj ponownie"

#: includes/class-admin-page.php:803
msgid "Show a button that reloads the page"
msgstr "Wyświetl przycisk, który odświeża stronę"

#: includes/class-admin-page.php:806
msgid "Button label"
msgstr "Tekst przycisku"

#: includes/class-admin-page.php:815
msgid "Automatic refresh"
msgstr "Automatyczne odświeżanie"

#: includes/class-admin-page.php:822
#: includes/class-admin-page.php:834
msgid "seconds"
msgstr "sekund"

#: includes/class-admin-page.php:823
msgid "The page reloads itself after this delay. 0 disables it."
msgstr "Strona odświeża się sama po tym czasie. 0 wyłącza odświeżanie."

#: includes/class-admin-page.php:827
msgid "Retry-After header"
msgstr "Nagłówek Retry-After"

#: includes/class-admin-page.php:835
msgid "Tells search engines and monitoring tools when to come back. 0 omits the header."
msgstr "Informuje wyszukiwarki i narzędzia monitorujące, kiedy wrócić. 0 pomija nagłówek."

#: includes/class-admin-page.php:839
msgid "Incident line"
msgstr "Wiersz incydentu"

#: includes/class-admin-page.php:842
msgid "Show the local time of the incident and the HTTP status under the message"
msgstr "Wyświetl lokalną godzinę incydentu i kod HTTP pod komunikatem"

#: includes/class-admin-page.php:846
msgid "Email alert"
msgstr "Powiadomienie e-mail"

#: includes/class-admin-page.php:849
msgid "Send an email when visitors see this page, and a report once the site is back"
msgstr "Wyślij e-mail, gdy odwiedzający zobaczą tę stronę, oraz podsumowanie po powrocie witryny"

#: includes/class-admin-page.php:852
msgid "Alert recipient"
msgstr "Odbiorca powiadomienia"

#: includes/class-admin-page.php:858
msgid "Leave empty to use the administration email address of the site."
msgstr "Pozostaw puste, aby użyć adresu e-mail administratora witryny."

#: includes/class-admin-page.php:865
#: includes/class-admin-page.php:976
msgid "HTTP status"
msgstr "Kod HTTP"

#: includes/class-admin-page.php:869
msgid "503 Service Unavailable (recommended)"
msgstr "503 Service Unavailable (zalecane)"

#: includes/class-admin-page.php:870
msgid "500 Internal Server Error (WordPress default)"
msgstr "500 Internal Server Error (domyślnie w WordPressie)"

#: includes/class-admin-page.php:872
msgid "503 tells search engines the problem is temporary and sends Retry-After. 500 signals a permanent error."
msgstr "503 informuje wyszukiwarki, że problem jest tymczasowy, i wysyła Retry-After. 500 oznacza trwały błąd."

#: includes/class-admin-page.php:895
msgid "Live preview"
msgstr "Podgląd na żywo"

#: includes/class-admin-page.php:897
msgid "Desktop"
msgstr "Komputer"

#: includes/class-admin-page.php:898
msgid "Mobile"
msgstr "Telefon"

#: includes/class-admin-page.php:904
msgid "Site shown:"
msgstr "Wyświetlana witryna:"

#: includes/class-admin-page.php:917
msgid "The preview follows what you type. Nothing is saved, and the pages of the site are left untouched, until you save."
msgstr "Podgląd śledzi to, co wpisujesz. Nic nie jest zapisywane, a strony witryny pozostają nietknięte, dopóki nie zapiszesz."

#: includes/class-admin-page.php:918
msgid "Open the saved page in a new tab"
msgstr "Otwórz zapisaną stronę w nowej karcie"

#: includes/class-admin-page.php:931
msgid "Test"
msgstr "Test"

#: includes/class-admin-page.php:933
msgid "Save and send a test alert"
msgstr "Zapisz i wyślij testowe powiadomienie"

#: includes/class-admin-page.php:934
msgid "While the database is down WordPress cannot run, so the alert is sent with the mail function of PHP. Some hosts block it, and it may land in spam: the test travels exactly the same way. The report goes through WordPress, like its other emails, once the error page has not been shown for five minutes."
msgstr "Gdy baza danych nie działa, WordPress nie może się uruchomić, więc powiadomienie jest wysyłane funkcją mail w PHP. Niektóre hostingi ją blokują, a wiadomość może trafić do spamu: test przechodzi dokładnie tą samą drogą. Podsumowanie idzie przez WordPressa, jak inne jego wiadomości, gdy strona błędu nie była wyświetlana od pięciu minut."

#: includes/class-admin-page.php:950
msgid "Each time a visitor sees one of the pages, the date, the page and the HTTP status are recorded, once a minute at most. Nothing about the visitors is kept, and nothing is recorded while nobody visits the site."
msgstr "Za każdym razem, gdy odwiedzający widzi jedną ze stron, zapisywane są data, strona i kod HTTP, najwyżej raz na minutę. Nic o odwiedzających nie jest przechowywane i nic nie jest zapisywane, gdy nikt nie odwiedza witryny."

#: includes/class-admin-page.php:952
msgid "Email alerts are off. Turn them on in the Database error tab to hear about an outage while it happens."
msgstr "Powiadomienia e-mail są wyłączone. Włącz je na karcie Błąd bazy danych, aby dowiedzieć się o awarii, gdy trwa."

#: includes/class-admin-page.php:954
msgid "Email alerts are on, but no valid address is set to receive them."
msgstr "Powiadomienia e-mail są włączone, ale nie ustawiono prawidłowego adresu do ich odbioru."

#. translators: %s: email address.
#: includes/class-admin-page.php:960
#, php-format
msgid "Email alerts about database outages go to %s."
msgstr "Powiadomienia e-mail o awariach bazy danych trafiają na adres %s."

#: includes/class-admin-page.php:968
msgid "No page has been shown to visitors so far."
msgstr "Jak dotąd żadna strona nie została pokazana odwiedzającym."

#: includes/class-admin-page.php:974
msgid "Started"
msgstr "Początek"

#: includes/class-admin-page.php:975
msgid "Observed duration"
msgstr "Zaobserwowany czas trwania"

#: includes/class-admin-page.php:990
msgid "The duration runs from the first to the last page shown. The 50 most recent incidents are listed, and the history keeps 180 days."
msgstr "Czas trwania liczony jest od pierwszej do ostatniej wyświetlonej strony. Lista obejmuje 50 najnowszych incydentów, a historia jest przechowywana przez 180 dni."

#: includes/class-admin-page.php:991
msgid "Delete the whole history?"
msgstr "Usunąć całą historię?"

#: includes/class-admin-page.php:994
msgid "Clear the history"
msgstr "Wyczyść historię"

#: includes/class-admin-page.php:1010
msgid "This page cannot be shown with the current PHP configuration."
msgstr "Tej strony nie można wyświetlić przy obecnej konfiguracji PHP."

#: includes/class-admin-page.php:1015
msgid "Current values:"
msgstr "Obecne wartości:"

#: includes/class-admin-page.php:1030
msgid "Regenerate"
msgstr "Wygeneruj ponownie"

#: includes/class-admin-page.php:1031
msgid "Saves the content of the pages again and restores missing drop-ins. Useful after changing the site title, the timezone or the logo file."
msgstr "Zapisuje ponownie treść stron i przywraca brakujące drop-iny. Przydatne po zmianie tytułu witryny, strefy czasowej lub pliku logo."

#: includes/class-admin-page.php:1035
msgid "Also replace files in wp-content that were not added by this plugin"
msgstr "Zastąp także pliki w wp-content, które nie zostały dodane przez tę wtyczkę"

#: includes/class-admin-page.php:1036
msgid "Regenerate pages now"
msgstr "Wygeneruj strony teraz"

#: includes/class-admin-page.php:1040
msgid "Deletes the drop-ins added by this plugin. WordPress shows its default screens again until you save or regenerate."
msgstr "Usuwa drop-iny dodane przez tę wtyczkę. WordPress znów wyświetla swoje domyślne ekrany, dopóki nie zapiszesz ustawień lub nie wygenerujesz stron ponownie."

#: includes/class-admin-page.php:1041
msgid "Remove the drop-ins from wp-content?"
msgstr "Usunąć drop-iny z wp-content?"

#: includes/class-admin-page.php:1044
msgid "Remove drop-ins from wp-content"
msgstr "Usuń drop-iny z wp-content"

#: includes/class-admin-page.php:1047
msgid "Manual installation"
msgstr "Instalacja ręczna"

#: includes/class-admin-page.php:1048
msgid "When wp-content is not writable, download the drop-ins and upload them to wp-content yourself. They are the same file under three names. The content of the pages is saved in the uploads folder, so later changes need no new upload."
msgstr "Gdy wp-content nie jest zapisywalny, pobierz drop-iny i sam wyślij je do wp-content. To ten sam plik pod trzema nazwami. Treść stron jest zapisywana w folderze uploads, więc późniejsze zmiany nie wymagają ponownego wysyłania."

#: includes/class-admin-page.php:1055
msgid "Files"
msgstr "Pliki"

#: includes/class-admin-page.php:1056
msgid "The drop-ins are copies of dropins/drop-in.php from the plugin folder. The content of the pages is saved here:"
msgstr "Drop-iny są kopiami pliku dropins/drop-in.php z folderu wtyczki. Treść stron jest zapisywana tutaj:"

#: includes/class-admin-page.php:1058
msgid "The alert settings, the theme folders and the history are kept next to it, in a private folder whose name cannot be guessed, because anyone can read a file in uploads when they know its address."
msgstr "Ustawienia powiadomień, foldery motywu i historia są przechowywane obok, w prywatnym folderze o nazwie niemożliwej do odgadnięcia, ponieważ każdy może odczytać plik w uploads, jeśli zna jego adres."

#: includes/class-admin-page.php:1060
msgid "WP-CLI"
msgstr "WP-CLI"

#: includes/class-admin-page.php:1067
msgid "Deactivation and uninstall"
msgstr "Dezaktywacja i odinstalowanie"

#: includes/class-admin-page.php:1068
msgid "Deactivating the plugin removes the three drop-ins from wp-content and keeps your settings. Uninstalling also removes the settings and the content folder in uploads. Files not added by this plugin are never touched."
msgstr "Dezaktywacja wtyczki usuwa trzy drop-iny z wp-content i zachowuje Twoje ustawienia. Odinstalowanie usuwa również ustawienia i folder z treścią w uploads. Pliki, które nie zostały dodane przez tę wtyczkę, nigdy nie są ruszane."

#: includes/class-admin-page.php:1203
msgid "You are not allowed to manage Offair."
msgstr "Nie masz uprawnień do zarządzania Offair."

#: includes/class-admin-page.php:1218
msgid "Unknown page."
msgstr "Nieznana strona."

#. translators: %s: site title.
#: includes/class-alert.php:35
#, php-format
msgid "[%s] The database cannot be reached"
msgstr "[%s] Baza danych jest nieosiągalna"

#. translators: 1: address of the site, 2: date and time of the page shown to a visitor.
#: includes/class-alert.php:38
#, php-format
msgid "The database of %1$s could not be reached at %2$s. Visitors see the database error page instead of the site."
msgstr "Baza danych witryny %1$s była nieosiągalna %2$s. Odwiedzający widzą stronę błędu bazy danych zamiast witryny."

#: includes/class-alert.php:39
msgid "While the problem lasts, a new alert is sent at most once an hour. A report follows once the site is back."
msgstr "Dopóki problem trwa, nowe powiadomienie jest wysyłane najwyżej raz na godzinę. Po powrocie witryny przyjdzie podsumowanie."

#: includes/class-alert.php:40
msgid "Sent by Offair from the database error page."
msgstr "Wysłane przez Offair ze strony błędu bazy danych."

#. translators: %s: subject of the alert.
#: includes/class-alert.php:45
#, php-format
msgid "Test: %s"
msgstr "Test: %s"

#: includes/class-alert.php:46
msgid "This is a test sent from the settings of Offair. A real alert looks like this and travels the same way."
msgstr "To jest test wysłany z ustawień Offair. Prawdziwe powiadomienie wygląda tak samo i przechodzi tą samą drogą."

#. translators: %s: site title.
#: includes/class-alert.php:97
#, php-format
msgid "[%s] The site is back"
msgstr "[%s] Witryna znów działa"

#. translators: 1: address of the site, 2: date and time of the first page shown, 3: time of the last page shown, 4: duration, for example "about 15 minutes".
#: includes/class-alert.php:103
#, php-format
msgid "The database of %1$s could not be reached from %2$s to %3$s (%4$s). Offair showed the database error page to visitors during that time."
msgstr "Baza danych witryny %1$s była nieosiągalna od %2$s do %3$s (%4$s). W tym czasie Offair wyświetlał odwiedzającym stronę błędu bazy danych."

#: includes/class-alert.php:109
msgid "These times come from the pages shown to visitors: while nobody visits the site, an outage cannot be seen."
msgstr "Te godziny pochodzą ze stron pokazanych odwiedzającym: gdy nikt nie odwiedza witryny, awarii nie da się zauważyć."

#. translators: %s: address of the history in the settings.
#: includes/class-alert.php:111
#, php-format
msgid "History of the outages: %s"
msgstr "Historia awarii: %s"

#. translators: %s: file name.
#: includes/class-dropins.php:130
#, php-format
msgid "wp-content/%s already exists and was not added by Offair, so it was left untouched. Use the Advanced tab to replace it."
msgstr "Plik wp-content/%s już istnieje i nie został dodany przez Offair, więc pozostał nietknięty. Użyj karty Zaawansowane, aby go zastąpić."

#. translators: %s: file name.
#: includes/class-dropins.php:147
#, php-format
msgid "Could not copy wp-content/%s. Download it from the Advanced tab and upload it yourself."
msgstr "Nie udało się skopiować wp-content/%s. Pobierz go na karcie Zaawansowane i wyślij samodzielnie."

#. translators: %s: file name.
#: includes/class-dropins.php:176
#, php-format
msgid "wp-content/%s was not added by Offair and was left untouched."
msgstr "Plik wp-content/%s nie został dodany przez Offair i pozostał nietknięty."

#. translators: %s: file name.
#: includes/class-dropins.php:186
#, php-format
msgid "Could not delete wp-content/%s."
msgstr "Nie udało się usunąć wp-content/%s."

#: includes/class-environment.php:71
msgid "PHP prints errors on screen because WP_DEBUG_DISPLAY is enabled in wp-config.php, and it does not buffer its output (the PHP directive output_buffering is off)."
msgstr "PHP wyświetla błędy na ekranie, ponieważ WP_DEBUG_DISPLAY jest włączone w wp-config.php, i nie buforuje swojego wyjścia (dyrektywa PHP output_buffering jest wyłączona)."

#: includes/class-environment.php:73
msgid "PHP prints errors on screen (the PHP directive display_errors is on) and does not buffer its output (the PHP directive output_buffering is off)."
msgstr "PHP wyświetla błędy na ekranie (dyrektywa PHP display_errors jest włączona) i nie buforuje swojego wyjścia (dyrektywa PHP output_buffering jest wyłączona)."

#: includes/class-environment.php:78
msgid "On a fatal error, PHP therefore sends the raw error message and the HTTP headers before WordPress runs its error handler, so WordPress never loads wp-content/php-error.php. Visitors see the raw PHP error with an HTTP 200 status instead of this page. The database and maintenance pages are not affected."
msgstr "Przy krytycznym błędzie PHP wysyła więc surowy komunikat błędu i nagłówki HTTP, zanim WordPress uruchomi swoją obsługę błędów, przez co WordPress nigdy nie wczytuje wp-content/php-error.php. Odwiedzający widzą zamiast tej strony surowy błąd PHP z kodem HTTP 200. Nie dotyczy to stron bazy danych i konserwacji."

#: includes/class-environment.php:79
msgid "To fix it, either disable WP_DEBUG_DISPLAY (recommended on a live site) or set output_buffering to 4096 in the PHP configuration (php.ini, .user.ini or the hosting panel)."
msgstr "Aby to naprawić, wyłącz WP_DEBUG_DISPLAY (zalecane na witrynie produkcyjnej) albo ustaw output_buffering na 4096 w konfiguracji PHP (php.ini, .user.ini lub panel hostingu)."

#: includes/class-journal.php:323
msgid "less than a minute"
msgstr "mniej niż minutę"

#. translators: %s: duration, for example "15 mins".
#: includes/class-journal.php:327
#, php-format
msgid "about %s"
msgstr "około %s"

#: includes/class-journal.php:339
msgid "Every 15 minutes (Offair)"
msgstr "Co 15 minut (Offair)"

#. translators: %s: folder path.
#: includes/class-pages.php:229
#, php-format
msgid "The page content could not be saved in %s. Check that the uploads folder is writable."
msgstr "Nie udało się zapisać treści stron w %s. Sprawdź, czy folder uploads jest zapisywalny."

#. translators: %s: folder path.
#: includes/class-pages.php:270
#, php-format
msgid "The content of the sites of the network could not be saved in %s. Check that the uploads folder is writable."
msgstr "Nie udało się zapisać treści witryn sieci w %s. Sprawdź, czy folder uploads jest zapisywalny."

#: includes/class-pages.php:718
msgid "Database temporarily unavailable (HTTP 503)."
msgstr "Baza danych chwilowo niedostępna (HTTP 503)."

#: includes/class-pages.php:719
msgid "Scheduled maintenance in progress (HTTP 503)."
msgstr "Trwa zaplanowana konserwacja (HTTP 503)."

#. translators: %d: HTTP status code.
#: includes/class-pages.php:721
#, php-format
msgid "Technical error (HTTP %d)."
msgstr "Błąd techniczny (HTTP %d)."

#. translators: 1: local time of the incident, filled in when the page is shown, 2: timezone name, 3: sentence describing the incident.
#: includes/class-pages.php:728
#, php-format
msgid "Incident recorded at %1$s (%2$s). %3$s"
msgstr "Incydent odnotowany o %1$s (%2$s). %3$s"

#. translators: Must match, word for word, the sentence used near the end of the default database error and maintenance messages: it is removed from the page when the automatic refresh is turned off.
#: includes/class-pages.php:741
msgid "This page refreshes on its own."
msgstr "Ta strona odświeża się sama."

#: includes/class-pages.php:752
msgid "Recovery mode is active: the extension that caused this error has been paused. Check the Plugins and Themes screens for details."
msgstr "Tryb odzyskiwania jest aktywny: rozszerzenie, które spowodowało ten błąd, zostało wstrzymane. Szczegóły znajdziesz na ekranach Wtyczki i Motywy."

#: includes/class-publisher.php:142
msgid "Up to date"
msgstr "Aktualne"

#: includes/class-publisher.php:143
msgid "Needs regeneration"
msgstr "Wymaga ponownego wygenerowania"

#: includes/class-publisher.php:144
msgid "Missing"
msgstr "Brak"

#: includes/class-publisher.php:145
msgid "Not added by this plugin"
msgstr "Nie dodano przez tę wtyczkę"

#: includes/class-publisher.php:146
msgid "Disabled"
msgstr "Wyłączona"

#: includes/class-settings.php:111
msgid "Database error"
msgstr "Błąd bazy danych"

#: includes/class-settings.php:112
msgid "Maintenance"
msgstr "Konserwacja"

#: includes/class-settings.php:113
msgid "PHP error"
msgstr "Błąd PHP"

#: includes/class-settings.php:128
msgid "Try again"
msgstr "Spróbuj ponownie"

#: includes/class-settings.php:147
msgid "We'll be right back"
msgstr "Zaraz wracamy"

#: includes/class-settings.php:148
msgid ""
"Our site is taking a short break because of a technical problem. It usually comes back within a few minutes.\n"
"\n"
"This page refreshes on its own. Thank you for your patience."
msgstr ""
"Nasza witryna ma krótką przerwę z powodu problemu technicznego. Zwykle wraca w ciągu kilku minut.\n"
"\n"
"Ta strona odświeża się sama. Dziękujemy za cierpliwość."

#: includes/class-settings.php:159
msgid "Back in a minute"
msgstr "Wracamy za minutę"

#: includes/class-settings.php:160
msgid ""
"We are installing an update. The site will be back in a moment.\n"
"\n"
"This page refreshes on its own. Thank you for your patience."
msgstr ""
"Instalujemy aktualizację. Witryna wróci za chwilę.\n"
"\n"
"Ta strona odświeża się sama. Dziękujemy za cierpliwość."

#: includes/class-settings.php:169
msgid "Something went wrong"
msgstr "Coś poszło nie tak"

#: includes/class-settings.php:170
msgid ""
"A technical error prevents us from displaying this page right now. Please try again in a few minutes.\n"
"\n"
"Thank you for your patience."
msgstr ""
"Błąd techniczny uniemożliwia nam teraz wyświetlenie tej strony. Spróbuj ponownie za kilka minut.\n"
"\n"
"Dziękujemy za cierpliwość."

#. translators: 1: page name, 2: file name.
#: includes/class-site-health.php:67
#, php-format
msgid "The %1$s page is enabled but wp-content/%2$s is missing."
msgstr "Strona %1$s jest włączona, ale brakuje pliku wp-content/%2$s."

#. translators: 1: page name, 2: file name.
#: includes/class-site-health.php:71
#, php-format
msgid "wp-content/%2$s does not match the current settings of the %1$s page."
msgstr "Plik wp-content/%2$s nie odpowiada obecnym ustawieniom strony %1$s."

#. translators: %s: file name.
#: includes/class-site-health.php:75
#, php-format
msgid "wp-content/%s was not added by Offair. The plugin leaves it untouched, so this page is not branded."
msgstr "Plik wp-content/%s nie został dodany przez Offair. Wtyczka go nie rusza, więc ta strona nie jest w barwach witryny."

#: includes/class-site-health.php:82
msgid "The PHP error page cannot be shown with the current PHP configuration."
msgstr "Strony błędu PHP nie można wyświetlić przy obecnej konfiguracji PHP."

#: includes/class-site-health.php:86
msgid "The uploads folder uses a custom path stored in the database, so the pages cannot read their content and show a neutral English page instead."
msgstr "Folder uploads używa niestandardowej ścieżki zapisanej w bazie danych, więc strony nie mogą odczytać swojej treści i zamiast tego wyświetlają neutralną stronę w języku angielskim."

#: includes/class-site-health.php:90
msgid "wp-content is not writable, so the pages cannot be written automatically. Download them from the settings page and upload them yourself."
msgstr "Katalog wp-content nie jest zapisywalny, więc strony nie mogą zostać zapisane automatycznie. Pobierz je ze strony ustawień i wyślij samodzielnie."

#: includes/class-site-health.php:98
msgid "Your downtime pages are in place"
msgstr "Twoje strony awaryjne są na miejscu"

#: includes/class-site-health.php:104
msgid "Visitors see a branded page when the database is unreachable, during updates and on fatal errors."
msgstr "Odwiedzający widzą stronę w barwach witryny, gdy baza danych jest nieosiągalna, podczas aktualizacji i przy krytycznych błędach."

#: includes/class-site-health.php:105
msgid "Open the Offair settings"
msgstr "Otwórz ustawienia Offair"

#: includes/class-site-health.php:110
msgid "Some downtime pages need attention"
msgstr "Niektóre strony awaryjne wymagają uwagi"
